---
# inventory/secrets.yml — REAL VALUES, ANSIBLE-VAULT ENCRYPTED, NEVER COMMITTED.
#
# This sample is the schema. To use it:
#   cp inventory/secrets.yml.sample inventory/secrets.yml
#   # fill in real values everywhere (replace every XXXXXXXXXXXXXXXXX)
#   ansible-vault encrypt inventory/secrets.yml
#   # then run playbooks with a vault id, e.g.:
#   ansible-navigator run --vault-id prod@prompt -m stdout main.yml -i inventory/inventory.yml
#
# The Caddy secrets at the bottom of this file are rendered into the live
# Caddyfile on dmz01. The preflight assert in main.yml FAILS if any of them is
# left as a placeholder — never run main.yml against the unedited sample.
# Rotation procedure for the Namecheap / CrowdSec keys: see RUNBOOK.md.
redhat:
  username: XXXXXXXXXXXXXXXXX
  password: XXXXXXXXXXXXXXXXX

ts:
  auth: tskey-auth-XXXXXX-XXXXXXXXXXXXXXXXX
  home_subnets: 192.168.2.0/24

proxmox_secrets:
  api:
    host: "192.168.2.253"
    port: 8006
    user: "XXXXXXXXXXXXXXXXX"
    token_id: "XXXXXXXXXXXXXXXXX"
    token_secret: "XXXXXXXXXXXXXXXXX"
  node_name: proxmox
  ssh:
    user: "XXXXXXXXXXXXXXXXX"
    port: 22
    ssh_identity_file: "XXXXXXXXXXXXXXXXX"
  template_name: "baseimage-tester"
  set_hostname: true
  ci:
    user: "XXXXXXXXXXXXXXXXX"
    password: "XXXXXXXXXXXXXXXXX"

ipa:
  admin_password: "XXXXXXXXXXXXXXXXX"

ansible_become_password: XXXXXXXXXXXXXXXXX
ansible_proxy_user: XXXXXXXXXXXXXXXXX

# Namecheap DNS-01 credentials — rendered into the caddy Caddyfile (dmz01).
# api_key only works from namecheap_client_ip: the key is IP-pinned to dmz01's
# public IP, which must stay whitelisted in the Namecheap console (Profile →
# Tools → Namecheap API Access). Rotation: RUNBOOK.md.
namecheap_email: XXXXXXXXXXXXXXXXX
namecheap_api_key: XXXXXXXXXXXXXXXXX
namecheap_user: XXXXXXXXXXXXXXXXX
namecheap_client_ip: XXXXXXXXXXXXXXXXX

# CrowdSec LAPI bouncer credentials — rendered into the caddy Caddyfile (dmz01).
# api_key comes from `podman exec crowdsec cscli bouncers add caddy-ansible`
# and is shown exactly once. Rotation: RUNBOOK.md.
crowdsec_api_url: http://localhost:8080
crowdsec_api_key: XXXXXXXXXXXXXXXXX